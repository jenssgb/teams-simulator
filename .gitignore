# --- Project-specific ---
# Downloaded installers (cached by setup/install.ps1)
setup/_downloads/
setup/_logs/
# LibriVox classics are downloaded on demand by scripts/download_long_samples.py
# (~73 MB - too large for the repo). The two business monologues
# (business_*.mp3, business_samples.json) ARE committed so users always
# have ~26 min of decent monologue content even with no internet on the VM.
samples/long/01_*.mp3
samples/long/02_*.mp3
samples/long/03_*.mp3
samples/long/long_samples.json
# User-supplied media (don't commit user audio/avatar files)
user_media/
*.user.wav
*.user.mp3
*.user.png
*.user.jpg

# Logs
*.log
logs/
